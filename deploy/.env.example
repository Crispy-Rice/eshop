# ============================================================
# 环境变量模板
#   本地开发：复制为 backend/.env
#   生产部署：复制为 deploy/.env，并把下面所有 dev-only-* 换成随机值
#            生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
#   这个文件本身不含任何真实密钥，可以提交到仓库。
# ============================================================

# ---- 应用 ----
APP_ENV=development                 # development / production
APP_VERSION=dev
LOG_LEVEL=DEBUG                     # DEBUG / INFO / WARNING
API_WORKERS=1                       # 本地 1；生产 4；2 核 2G 演示环境 1

# ---- PostgreSQL ----
# 容器启动时用它初始化；应用用 DATABASE_URL 连接
POSTGRES_DB=eshop
POSTGRES_OWNER_USER=eshop_owner
POSTGRES_OWNER_PASSWORD=dev-only-owner-password
POSTGRES_APP_USER=eshop_app
POSTGRES_APP_PASSWORD=dev-only-app-password
POSTGRES_READONLY_USER=eshop_readonly
POSTGRES_READONLY_PASSWORD=dev-only-readonly-password
POSTGRES_PORT=5432

# 应用连接串（asyncpg 驱动）。生产指向容器名 postgres，本地指向 127.0.0.1
DATABASE_URL=postgresql+asyncpg://eshop_app:dev-only-app-password@127.0.0.1:5432/eshop
# 迁移用的连接串（需要 DDL 权限，用 owner 角色）
MIGRATION_DATABASE_URL=postgresql+asyncpg://eshop_owner:dev-only-owner-password@127.0.0.1:5432/eshop
DB_ECHO=false

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379

# ---- 安全（生产必须全部替换）----
# 注意：HS256 的密钥至少要 32 字节，太短 PyJWT 会告警且安全性不足
JWT_SECRET=dev-only-jwt-secret-change-me-32bytes-min
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
PRICE_TOKEN_SECRET=dev-only-price-secret-change-me-32bytes-min
PRICE_TOKEN_TTL_MINUTES=30
# 手机号：哈希用于查询与唯一约束，加密用于展示。ENC_KEY 必须是 32 字节的 base64
PHONE_HASH_KEY=dev-only-phone-hash-key-change-me-32bytes-min
PHONE_ENC_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# ---- 支付 ----
# ★ 接入真实渠道上线前必须改为 false
PAYMENT_MOCK_ENABLED=true
MOCK_PAY_SECRET=dev-only-mock-pay-secret-change-me-32bytes-min
PAY_NOTIFY_BASE_URL=http://127.0.0.1:8000

# ---- 存储 ----
MEDIA_ROOT=./data/media
MEDIA_URL_PREFIX=/media/
MEDIA_MAX_IMAGE_MB=5

# ---- AI 助手（docs/20-assistant.md）----
# 总开关。助手要调外部模型 API、要花钱，出问题时要能一键关掉而不是等发版
ASSISTANT_ENABLED=true
# 阿里云百炼的 **OpenAI 兼容模式**：协议就是 chat/completions，所以只用 httpx + JSON，
# 不引入任何厂商 SDK
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# 思考模式。**默认关**：助手是"查数再答"，不需要长链推理；开着会多花 output token、
# 多等几秒，而且思考模式下不能强制 required 工具（我们最后一轮要用 tool_choice=none 收尾）。
# ★ 若模型根本不接受这个字段，上游会返回 400 —— 排查时看 api/worker 日志里那句
#   「助手上游调用失败」后面的原始报文（service 会把它记下来）。
LLM_ENABLE_THINKING=false
# ★ 生产环境不配这个就启动失败（开了助手却没有能用的密钥，只会让每次提问白跑一趟再失败）
#   注意它**不是** HMAC 密钥，所以不套"至少 32 字节"那条规则
LLM_API_KEY=dev-only-llm-api-key-change-me
LLM_TIMEOUT_SECONDS=30
# 限流与预算（见 docs/20 §7）。调这些不用发版
ASSISTANT_USER_RATE_PER_MINUTE=10
ASSISTANT_SHOP_RATE_PER_MINUTE=20
ASSISTANT_DAILY_TOKEN_BUDGET_USER=50000
ASSISTANT_DAILY_TOKEN_BUDGET_SHOP=300000

