# ============================================================
# 生产环境变量模板
#
# 不是手工复制粘贴用的 —— 用脚本生成，它会填掉下面所有 __GENERATE__：
#   cd deploy && ./scripts/gen-secrets.sh
# 生成的是 deploy/.env（权限 600，已在 .gitignore 里）。
#
# 生成后请把 .env 备份到密码管理器。★ 丢了 PHONE_ENC_KEY 就解不开
# 已存的手机号，无法恢复（docs/13-schema.md §2）。
#
# 本文件本身不含任何真实密钥，可以提交到仓库。
# ============================================================

# ---- 应用 ----
# ★ 演示环境也用 production：这样密钥自检、/docs 关闭等生产行为都会生效。
#   模拟支付另外用 ALLOW_MOCK_PAYMENT_IN_PROD 显式授权（见下）。
APP_ENV=production
APP_VERSION=v0.1.0
LOG_LEVEL=INFO
# 生产 4；2 核 2G 演示机用 docker-compose.demo.yml 覆盖为 1
API_WORKERS=4

# 对外 HTTP 端口。独占这台机器时用 80；演示机上 80 已被另一个应用的
# nginx 占着（`listen 80 default_server`，会吃掉 80 上所有请求），
# 所以 eshop 走 8081。容器内部始终监听 80。
# ★ 改了这里，安全组也要放行对应端口。
ESHOP_HTTP_PORT=8081

# ---- PostgreSQL ----
POSTGRES_DB=eshop
POSTGRES_OWNER_USER=eshop_owner
POSTGRES_OWNER_PASSWORD=__GENERATE__
POSTGRES_APP_USER=eshop_app
POSTGRES_APP_PASSWORD=__GENERATE__
POSTGRES_READONLY_USER=eshop_readonly
POSTGRES_READONLY_PASSWORD=__GENERATE__

# 连接串由 gen-secrets.sh 按上面生成的口令拼好（注意主机名是 compose 服务名）
DATABASE_URL=__DERIVED__
# 迁移用 owner 角色（需要 DDL 权限）；应用角色建不了表
MIGRATION_DATABASE_URL=__DERIVED__
DB_ECHO=false

# ---- Redis ----
REDIS_PASSWORD=__GENERATE__
REDIS_URL=__DERIVED__

# ---- 安全（全部由脚本生成，32 字节以上）----
JWT_SECRET=__GENERATE__
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
# priceToken 目前尚未接入（docs/11），但生产自检要求它是个真密钥
PRICE_TOKEN_SECRET=__GENERATE__
PRICE_TOKEN_TTL_MINUTES=30
PHONE_HASH_KEY=__GENERATE__
# 必须是 32 字节的 base64（AES-256-GCM）。脚本用 token_bytes(32) 生成
PHONE_ENC_KEY=__GENERATE__
PASSWORD_MIN_LENGTH=8

# ---- 支付 ----
# 第一期只有模拟渠道，所以 true + 下面那行显式授权是**配套**的：
#   PAYMENT_MOCK_ENABLED=true 且没有 ALLOW_MOCK_PAYMENT_IN_PROD ⇒ 启动即失败
# 将来接真实渠道：把 ENABLED 改成 false，这行可以留着（那时它不起作用）
PAYMENT_MOCK_ENABLED=true
ALLOW_MOCK_PAYMENT_IN_PROD=true
MOCK_PAY_SECRET=__GENERATE__
# 模拟渠道回调的对外地址。演示环境就是服务器 IP，不要带结尾斜杠
PAY_NOTIFY_BASE_URL=http://CHANGE_ME_SERVER_IP

# ---- 存储 ----
# 宿主机的 /data/media 绑进容器；nginx 只读挂载它（见 docker-compose.yml）
MEDIA_ROOT=/data/media
MEDIA_URL_PREFIX=/media/
MEDIA_MAX_IMAGE_MB=5
