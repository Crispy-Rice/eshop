{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "backend",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "worker",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "backend",
        "arq",
        "app.worker.main.WorkerSettings"
      ]
    },
    {
      "name": "web-mall",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web-mall", "run", "dev"],
      "port": 5173
    },
    {
      "name": "web-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web-admin", "run", "dev"],
      "port": 5174
    },
    {
      "name": "web-mall-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web-mall",
        "run",
        "dev",
        "--",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199
    },
    {
      "name": "web-admin-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web-admin",
        "run",
        "dev",
        "--",
        "--port",
        "5198",
        "--strictPort"
      ],
      "port": 5198
    }
  ]
}
