{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "backend",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web-mall",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web-mall", "run", "dev"],
      "port": 5173
    },
    {
      "name": "web-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web-admin", "run", "dev"],
      "port": 5174
    }
  ]
}
